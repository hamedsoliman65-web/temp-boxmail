{
  "version": 2,
  "cleanUrls": true,

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
       {
  "key": "Content-Security-Policy",
  "value": "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
},

        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },

        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },

        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],

  "rewrites": [
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/og.webp", "destination": "/og.webp" },
    { "source": "/purify.min.js", "destination": "/purify.min.js" },
    { "source": "/article_nav.js", "destination": "/article_nav.js" },
    { "source": "/mail.js", "destination": "/mail.js" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" }
  ]
}
